        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(opskit_findings_total{severity=\"WARNING\"}) or vector(0)",
          "legendFormat": "Warnings",
          "refId": "A"
        }
      ],
      "title": "Warnings Active",
      "type": "stat"
