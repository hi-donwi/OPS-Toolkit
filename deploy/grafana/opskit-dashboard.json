      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "opskit_findings_total",
          "legendFormat": "{{target}} [{{severity}}]",
          "refId": "A"
        }
      ],
      "title": "Diagnostic Findings History (Host, Docker, Swarm, Kubernetes, Security)",
      "type": "timeseries"
